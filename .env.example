# Copy to .env.local for local development. Never commit real values.

# Runtime connection used by the app (restricted role `aio_app`, pooled host).
# Created by `npm run db:setup`. This is the only DB variable Vercel needs.
DATABASE_URL=postgresql://aio_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full

# Owner connection (direct host, no "-pooler"), used only locally for
# migrations and setup scripts. Do not add this to Vercel.
DATABASE_URL_OWNER=postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full

# Password for the aio_app role (written by `npm run db:setup`).
AIO_APP_DB_PASSWORD=

# 32+ random bytes, base64url. Signs session cookies and encrypts parent links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Vercel Blob (private store). On Vercel this is injected automatically when the
# store is connected to the project. Locally, paste the store's read-write token;
# without it, photos are saved to ./.uploads in development.
BLOB_READ_WRITE_TOKEN=
